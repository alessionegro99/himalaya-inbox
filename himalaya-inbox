MAX_ATTACHMENT_BYTES = 20 * 1024 * 1024


def run_private(args: list[str], data: bytes | None = None) -> bytes:
    """Capture diagnostics privately, including authentication-helper output."""
    process = None
    try:
        with IO_LOCK:
            if IO_STOP.is_set():
                raise RuntimeError('Mail request cancelled.')
            process = subprocess.Popen(
                [HIMALAYA, '--log-level', 'off', *CONFIG_ARGS, *args],
                stdin=subprocess.PIPE if data is not None else subprocess.DEVNULL,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True,
            )
            IO_PROCESSES.add(process)
        output, _ = process.communicate(input=data, timeout=60)
        if process.returncode != 0:
            raise RuntimeError('Himalaya command failed; private diagnostics suppressed.')
        return output
    except (subprocess.TimeoutExpired, OSError, ValueError):
        if process is not None and process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.communicate()
        raise RuntimeError('Himalaya timed out or returned invalid output; private diagnostics suppressed.') from None
    finally:
        if process is not None:
            if process.poll() is None:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.communicate()
            with IO_LOCK:
                IO_PROCESSES.discard(process)


def background(function, *args) -> Future:
    """Run a bounded UI job without putting curses calls on a worker thread."""
    future = Future()

    def run() -> None:
        if not future.set_running_or_notify_cancel():
            return
        try:
            future.set_result(function(*args))
        except Exception:
            future.set_exception(RuntimeError('Background mail request failed; private diagnostics suppressed.'))

    Thread(target=run, name='inbox-background', daemon=True).start()
    return future


def stop_background() -> None:
    """Stop outstanding read jobs on exit, including their private auth helpers."""
    with IO_LOCK:
        IO_STOP.set()
        for process in IO_PROCESSES:
            if process.poll() is None:
                try:
                    # Each request has its own session: never signal a terminal,
                    # desktop keyring, or another application's process group.
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass


def run_himalaya(args: list[str]) -> dict:
    """Decode only successful JSON responses; never expose malformed output."""
    try:
        return json.loads(run_private(['--json', *args]))
    except ValueError:
        raise RuntimeError('Himalaya returned invalid JSON; private diagnostics suppressed.') from None


def fetch(account: str, limit: int | None, mailbox: str = 'inbox') -> list[dict]:
    """Fetch enough sorted headers for a global limit, or paginate the whole inbox."""
    page_size = min(limit, 500) if limit is not None else 500
    rows = {}
    page = 1
    try:
        while True:
            batch = run_himalaya([
                '--account', account, 'envelope', 'list', '--mailbox', mailbox,
                '--page', str(page), '--page-size', str(page_size),
            ])['envelopes']
            previous_count = len(rows)
            for envelope in batch:
                # Keep account-scoped IDs; different accounts can share a UID.
                rows[str(envelope['id'])] = dict(envelope, account=account, mailbox=mailbox)
            if len(batch) < page_size or (limit is not None and len(rows) >= limit):
                break
            if len(rows) == previous_count:
                raise RuntimeError('Pagination made no progress.')
            page += 1
    except (RuntimeError, KeyError, TypeError):
        raise RuntimeError(f'Could not list {account}; no partial unified inbox was displayed.') from None
    return list(rows.values())


def message_ids(value: object) -> list[str]:
    """Extract RFC 5322 IDs without case folding the case-sensitive local part."""
    return re.findall(r'<([^<>\s]+)>', str(value or ''))


def normalized_id(value: str | None) -> str:
    """Himalaya versions may include or omit the surrounding angle brackets."""
    return (value or '').strip().strip('<>')


def imap_mailbox(name: str) -> str:
    """Encode modified UTF-7 (RFC 3501 §5.1.3) and quote an IMAP mailbox.

    Backslashes are rejected because Himalaya raw decodes literal \\n/\\r.
    https://www.rfc-editor.org/rfc/rfc3501#section-5.1.3
    """
    if any(not c.isprintable() or c == '\\' for c in name):
        raise RuntimeError('Unsupported mailbox name for safe header fetching.')
    parts = []
    pending = ''
    for char in name + '\x00':
        if ord(char) >= 127:
            pending += char
            continue
        if pending:
            parts.append('&' + base64.b64encode(pending.encode('utf-16-be')).decode().rstrip('=').replace('/', ',') + '-')
            pending = ''
        if char != '\x00':
            parts.append('&-' if char == '&' else char)
    return '"' + ''.join(parts).replace('"', '\\"') + '"'


def parse_reference_fetch(output: bytes) -> dict[str, list[str]]:
    """Read length-delimited IMAP header literals, not message bodies."""
    result = {}
    position = 0
    protocol = []
    pattern = re.compile(rb'\* \d+ FETCH \([^\r\n]*\{(\d+)\}\r\n', re.I)
    while match := pattern.search(output, position):
        end = match.end() + int(match[1])
        if end > len(output):
            raise RuntimeError('Truncated threading headers.')
        suffix_end = output.find(b'\r\n', end)
        if suffix_end < 0:
            raise RuntimeError('Incomplete threading response.')
        protocol.append(output[position:match.end()])
        uid = re.search(rb'\bUID (\d+)\b', match[0] + output[end:suffix_end], re.I)
        if not uid:
            raise RuntimeError('Threading header lacked its mailbox UID.')
        headers = Parser(policy=policy.default).parsestr(output[match.end():end].decode('utf-8', 'replace'), headersonly=True)
        result[uid[1].decode()] = message_ids(headers.get('References'))
        position = end
    protocol.append(output[position:])
    safe_protocol = b''.join(protocol)
    for tag in (b'hi1', b'hi2'):
        if not re.search(rb'^' + tag + rb' OK\b', safe_protocol, re.M | re.I):
            raise RuntimeError('Server could not provide threading headers.')
    return result


def add_references(account: str, mailbox: str, rows: list[dict]) -> None:
    """Fetch all ancestry headers in batches with EXAMINE and BODY.PEEK."""
    missing = []
    for row in rows:
        key = (account, normalized_id(row.get('message-id')))
        if key in REFERENCE_CACHE:
            row['references'] = list(REFERENCE_CACHE[key])
        else:
            missing.append(row)
    rows = missing
    for start in range(0, len(rows), 250):
        batch = rows[start:start + 250]
        if any(not str(row['id']).isdigit() for row in batch):
            raise RuntimeError('Full threading currently requires IMAP accounts.')
        sequence = ','.join(str(row['id']) for row in batch)
        commands = (f'hi1 EXAMINE {imap_mailbox(mailbox)}\r\n'
                    f'hi2 UID FETCH {sequence} (UID BODY.PEEK[HEADER.FIELDS (REFERENCES)])\r\n')
        # Himalaya 2.1's stdin parser strips the final line ending, then its raw
        # command appends bare LF. Gmail requires CRLF. An extra empty stdin line
        # preserves the terminating CRLF after lines().join("\r\n").
        # https://github.com/pimalaya/himalaya/blob/v2.1.0/src/shared/raw.rs
        refs = parse_reference_fetch(run_private(['--account', account, 'imap', 'raw'], (commands + '\r\n').encode()))
        if any(str(row['id']) not in refs for row in batch):
            raise RuntimeError('Mailbox changed while fetching threading headers; refresh to retry.')
        for row in batch:
            row['references'] = refs[str(row['id'])]


def mailbox_states(account: str, mailboxes: list[str]) -> dict[str, dict[str, int]]:
    """Batch independent STATUS commands; never change the selected mailbox.

    HIGHESTMODSEQ detects flag changes; counts alone would miss read/unread
    changes made in another client. Zero/unsupported MODSEQ means no reuse.
    https://www.rfc-editor.org/rfc/rfc7162#section-3.1.7
    """
    if not mailboxes:
        return {}
    try:
        commands = ''.join(f'hs{i} STATUS {imap_mailbox(name)} (MESSAGES UIDVALIDITY UIDNEXT HIGHESTMODSEQ)\r\n'
                           for i, name in enumerate(mailboxes))
        raw = run_private(['--account', account, 'imap', 'raw'], (commands + '\r\n').encode())
        return parse_mailbox_states(raw, mailboxes)
    except (RuntimeError, ValueError, KeyError):
        # Older servers still work: fall back to fetching their folder headers.
        return {}


def parse_mailbox_states(raw: bytes, mailboxes: list[str]) -> dict[str, dict[str, int]]:
    """Match STATUS replies by mailbox, not completion order; honor literals."""
    expected = {imap_mailbox(name)[1:-1].replace('\\"', '"').encode('ascii'): name for name in mailboxes}
    states, completed = {}, set()
    position = 0
    while position < len(raw):
        end = raw.find(b'\r\n', position)
        if end < 0:
            break
        line = raw[position:end]
        position = end + 2
        if match := re.fullmatch(rb'hs(\d+) OK(?: .*)?', line, re.I):
            completed.add(int(match[1]))
            continue
        if not line.upper().startswith(b'* STATUS '):
            continue
        rest = line[9:]
        if match := re.match(rb'\{(\d+)\}$', rest):
            length = int(match[1])
            if position + length > len(raw):
                raise ValueError('Truncated mailbox literal')
            name = raw[position:position + length]
            end = raw.find(b'\r\n', position + length)
            if end < 0:
                raise ValueError('Truncated STATUS response')
            attributes = raw[position + length:end]
            position = end + 2
        elif match := re.match(rb'"((?:[^"\\]|\\.)*)"(.*)$', rest):
            name = re.sub(rb'\\(.)', rb'\1', match[1])
            attributes = match[2]
        else:
            name, _, attributes = rest.partition(b' ')
        if name not in expected:
            continue
        match = re.fullmatch(rb'\s*\(([^()]*)\)', attributes)
        if not match:
            continue
        fields = match[1].split()
        if len(fields) % 2 or any(not value.isdigit() for value in fields[1::2]):
            continue
        values = {key.decode('ascii').upper(): int(value) for key, value in zip(fields[::2], fields[1::2])}
        if {'MESSAGES', 'UIDVALIDITY', 'UIDNEXT', 'HIGHESTMODSEQ'} <= values.keys() and values['UIDVALIDITY'] > 0 and values['UIDNEXT'] > 0:
            states[expected[name]] = values
    return {name: states[name] for i, name in enumerate(mailboxes) if i in completed and name in states}


def read_header_cache() -> None:
    """Load the previous view; verify server state before treating it as fresh."""
    global HEADER_CACHE_READY
    if HEADER_CACHE_PATH is None:
        return
    try:
        if HEADER_CACHE_PATH.stat().st_size > 64 * 1024 * 1024:
            return
        data = json.loads(HEADER_CACHE_PATH.read_text(encoding='utf-8'))
        if data['version'] != 2 or data['accounts'] != sorted(SETTINGS) or not isinstance(data['folders'], list):
            return
        entries = {}
        for item in data['folders']:
            account, mailbox, rows, state = item['account'], item['mailbox'], item['rows'], item['state']
            if account not in SETTINGS or not isinstance(mailbox, str) or not isinstance(rows, list):
                raise ValueError('Invalid cache')
            if any(not isinstance(row, dict) or row.get('account') != account or row.get('mailbox') != mailbox
                   or not {'id', 'flags', 'from', 'subject', 'references'} <= row.keys() for row in rows):
                raise ValueError('Invalid cached folder')
            for row in rows:
                if not str(row['id']).isdigit() or not isinstance(row['flags'], list) or not isinstance(row['references'], list):
                    raise ValueError('Invalid cached message')
                for field in ('flags', 'from', 'to'):
                    values = row.get(field) or []
                    if not isinstance(values, list) or any(not isinstance(value, dict) for value in values):
                        raise ValueError('Invalid cached headers')
                for field in ('references', 'in-reply-to'):
                    values = row.get(field) or []
                    if not isinstance(values, list) or any(not isinstance(value, str) for value in values):
                        raise ValueError('Invalid cached ancestry')
                if row.get('message-id') is not None and not isinstance(row['message-id'], str):
                    raise ValueError('Invalid cached identity')
                if row.get('uidvalidity') is not None and not isinstance(row['uidvalidity'], int):
                    raise ValueError('Invalid cached UID validity')
            entries[account, mailbox] = {'state': state, 'rows': rows}
        FOLDER_CACHE.update(entries)
        HEADER_CACHE_READY = True
    except (OSError, ValueError, KeyError, TypeError):
        return


def write_header_cache() -> None:
    """Atomically persist headers only, never bodies, passwords or configuration."""
    if HEADER_CACHE_PATH is None:
        return
    temporary = None
    try:
        directory = HEADER_CACHE_PATH.parent
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        directory.chmod(0o700)
        fields = {'account', 'mailbox', 'id', 'message-id', 'in-reply-to', 'references', 'from', 'to',
                  'date', 'flags', 'subject', 'in_inbox', 'sent', 'uidvalidity'}
        data = {'version': 2, 'accounts': sorted(SETTINGS), 'folders': [dict(account=account, mailbox=mailbox, state=item['state'],
                                            rows=[{key: value for key, value in row.items() if key in fields} for row in item['rows']])
                                       for (account, mailbox), item in FOLDER_CACHE.items()]}
        descriptor, name = tempfile.mkstemp(prefix='.headers-', dir=directory)
        temporary = Path(name)
        with os.fdopen(descriptor, 'w', encoding='utf-8') as file:
            json.dump(data, file, ensure_ascii=False)
        temporary.replace(HEADER_CACHE_PATH)
    except (OSError, ValueError):
        # A read-only/full cache directory must not make mail inaccessible.
        pass
    finally:
        if temporary is not None:
            try:
                temporary.unlink(missing_ok=True)
            except OSError:
                pass


def load_account(account: str) -> list[dict]:
    """Check folder changes; fetch headers only when a safe cached copy is absent."""
    settings = SETTINGS[account]
    if 'imap' not in settings:
        raise RuntimeError('Full conversation browsing currently requires IMAP accounts.')
    aliases = settings.get('mailbox', {}).get('alias', {})
    previous = {mailbox: item for (owner, mailbox), item in FOLDER_CACHE.copy().items() if owner == account}
    # On warm loads, folder discovery and change checks overlap instead of
    # paying for two serial logins. Both requests are read-only.
    with ThreadPoolExecutor(max_workers=2) as pool:
        listing = pool.submit(run_himalaya, ['--account', account, 'imap', 'list', '--all'])
        checking = pool.submit(mailbox_states, account, list(previous))
        boxes, states = listing.result()['mailboxes'], checking.result()
    excluded = {aliases.get(role, '').casefold() for role in ('drafts', 'trash', 'junk', 'spam')}
    excluded |= {'drafts', 'trash', 'junk', 'spam', 'deleted', 'deleted items', 'cestino', 'bozze'}
    selected = []
    for box in boxes:
        mailbox = box['name']
        attrs = {a.casefold().lstrip('\\') for a in box['attributes']}
        if attrs & {'noselect', 'drafts', 'trash', 'junk'}:
            continue
        leaf = mailbox.rsplit('/', 1)[-1].casefold()
        delimiter = box.get('delimiter') or '/'
        is_excluded = any(value and (mailbox.casefold() == value or mailbox.casefold().startswith(value + delimiter))
                          for value in excluded)
        if is_excluded or leaf in excluded or mailbox in ('[Gmail]', '[Google Mail]'):
            continue
        selected.append(box)
    new_boxes = [box['name'] for box in selected if box['name'] not in previous]
    states.update(mailbox_states(account, new_boxes))

    def load_box(box: dict) -> tuple[str, dict]:
        mailbox = box['name']
        attrs = {a.casefold().lstrip('\\') for a in box['attributes']}
        state = states.get(mailbox)
        cached = previous.get(mailbox)
        try:
            if state and state['MESSAGES'] == 0:
                rows = []
            elif (state and state['HIGHESTMODSEQ'] > 0 and cached and state == cached['state']
                  and len(cached['rows']) == state['MESSAGES']):
                rows = [dict(row) for row in cached['rows']]
            else:
                rows = fetch(account, None, mailbox)
                add_references(account, mailbox, rows)
        except RuntimeError as error:
            raise RuntimeError(f'{clean(account)} / {clean(mailbox)}: {error}') from None
        for row in rows:
            row['in_inbox'] = mailbox.casefold() == aliases.get('inbox', 'INBOX').casefold()
            row['sent'] = mailbox == aliases.get('sent') or 'sent' in attrs
            row['uidvalidity'] = state['UIDVALIDITY'] if state else None
        return mailbox, {'state': state, 'rows': rows}

    # Profiling showed network round trips, not grouping, dominate loading.
    # Bound concurrency per account to avoid excessive IMAP connections.
    with ThreadPoolExecutor(max_workers=2) as pool:
        results = dict(pool.map(load_box, selected))
    for mailbox in previous.keys() - results.keys():
        FOLDER_CACHE.pop((account, mailbox), None)
    FOLDER_CACHE.update({(account, mailbox): item for mailbox, item in results.items()})
    return [row for item in results.values() for row in item['rows']]


def deduplicate(rows: list[dict]) -> list[dict]:
    """Merge label/folder copies within an account; keep their exact read location."""
    unique = {}
    # Prefer Inbox over Sent over Archive when one message has multiple labels.
    for row in sorted(rows, key=lambda r: (not r.get('in_inbox', False), not r.get('sent', False))):
        key = (row['account'], normalized_id(row.get('message-id')) or (row.get('mailbox'), str(row['id'])))
        if key not in unique:
            unique[key] = dict(row)
        else:
            unique[key]['sent'] = unique[key].get('sent', False) or row.get('sent', False)
    return merge([list(unique.values())], None)


def load_all() -> list[dict]:
    """Load accounts in parallel; fail visibly instead of hiding incomplete threads."""
    global CONTACTS, REFERENCE_CACHE, PREFETCH_KEY
    with ThreadPoolExecutor(max_workers=min(len(SETTINGS), 5)) as pool:
        rows = deduplicate([row for batch in pool.map(load_account, SETTINGS) for row in batch])
    CONTACTS = collect_contacts(rows)
    # A Message-ID identifies an immutable message (the same identity used by
    # deduplicate). Scope by account, never reuse a bare mailbox UID after reset.
    # https://www.rfc-editor.org/rfc/rfc5322#section-3.6.4
    REFERENCE_CACHE = {
        (row['account'], normalized_id(row.get('message-id'))): tuple(row['references'])
        for row in rows if normalized_id(row.get('message-id')) and 'references' in row
    }
    # Retain opened bodies only if the refreshed index confirms their identity.
    valid = {message_cache_key(row) for row in rows if row.get('uidvalidity') or normalized_id(row.get('message-id'))}
    with MESSAGE_CACHE_LOCK:
        for key in list(MESSAGE_CACHE):
            if key not in valid:
                del MESSAGE_CACHE[key]
    write_header_cache()
    PREFETCH_KEY = None
    return rows


def collect_contacts(rows: list[dict]) -> list[dict[str, str]]:
    """Collect only public address headers already loaded; never bodies or Bcc.

    Most recent nonempty display names win. Address parses use the same standard
    library as draft validation, rather than guessing valid addresses with regex.
    https://docs.python.org/3/library/email.headerregistry.html#email.headerregistry.Address
    """
    contacts = {}
    for row in sorted(rows, key=message_date, reverse=True):
        for field in ('from', 'to'):
            for value in row.get(field) or []:
                address = value.get('email')
                if not isinstance(address, str) or not address or not all(c.isprintable() for c in address):
                    continue
                try:
                    parsed = Address(addr_spec=address)
                except (ValueError, HeaderParseError, IndexError, AttributeError):
                    # Malformed input can also hit bugs in the stdlib parser.
                    continue
                if not parsed.username or not parsed.domain:
                    continue
                # Only the domain is case-insensitive in the mail standard.
                key = (parsed.username, parsed.domain.casefold())
                name = clean(value.get('name') or '')[:120]
                if key not in contacts:
                    contacts[key] = {'email': parsed.addr_spec, 'name': name}
                elif not contacts[key]['name'] and name:
                    contacts[key]['name'] = name
    return sorted(contacts.values(), key=lambda c: ((c['name'] or c['email']).casefold(), c['email']))


def message_date(row: dict) -> datetime:
    """Normalize offsets for ordering; place absent or invalid dates last."""
    try:
        value = datetime.fromisoformat(row.get('date') or '')
        if value.tzinfo is None:
            raise ValueError('Date lacks a timezone')
        return value.astimezone(timezone.utc)
    except (ValueError, TypeError):
        return datetime.min.replace(tzinfo=timezone.utc)


def merge(batches: list[list[dict]], limit: int | None) -> list[dict]:
    """Merge descending lists; the global newest N are in each account's top N."""
    rows = [row for batch in batches for row in batch]
    rows.sort(key=lambda row: (message_date(row), row['account'], str(row['id'])), reverse=True)
    return rows if limit is None else rows[:limit]


def clean(value: object) -> str:
    """Strip terminal controls and collapse header whitespace before display."""
    return ' '.join(''.join(char if char.isprintable() else ' ' for char in str(value)).split())


def is_unread(row: dict) -> bool:
    """Inspect flags without modifying the message."""
    return not any(
        flag.get('iana') == 'seen' or flag.get('raw', '').lower() == '\\seen'
        for flag in row.get('flags', [])
    )


def conversations(rows: list[dict]) -> list[list[dict]]:
    """Group connected reply IDs; never infer relationships from subjects.

    Connected components via iterative depth-first search. Shared absent parents
    still connect siblings. Himalaya normalizes Message-ID and In-Reply-To alike.
    https://networkx.org/documentation/stable/reference/algorithms/generated/networkx.algorithms.components.connected_components.html
    References connect ancestors even when an intermediate message is absent.
    All account-specific message copies are retained.
    """
    graph = [set() for _ in rows]
    owners = {}
    for index, row in enumerate(rows):
        for token in [row.get('message-id'), *(row.get('in-reply-to') or []), *(row.get('references') or [])]:
            token = normalized_id(token)
            if token:
                other = owners.setdefault(token, index)
                graph[index].add(other)
                graph[other].add(index)
    seen = set()
    groups = []
    for start in range(len(rows)):
        if start in seen:
            continue
        pending = [start]
        members = []
        seen.add(start)
        while pending:
            index = pending.pop()
            members.append(index)
            for other in graph[index] - seen:
                seen.add(other)
                pending.append(other)
        groups.append([rows[index] for index in sorted(members)])
    return groups


class HtmlText(HTMLParser):
    """Extract readable text without running scripts or fetching remote content."""

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.parts: list[str] = []
        self.hidden = 0

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag in {'head', 'script', 'style'}:
            self.hidden += 1
        if not self.hidden and tag in {'br', 'p', 'div', 'tr', 'li', 'h1', 'h2', 'h3', 'hr'}:
            self.parts.append('\n')

    def handle_endtag(self, tag: str) -> None:
        if tag in {'head', 'script', 'style'}:
            self.hidden = max(0, self.hidden - 1)
        if not self.hidden and tag in {'p', 'div', 'tr', 'li', 'h1', 'h2', 'h3'}:
            self.parts.append('\n')

    def handle_data(self, data: str) -> None:
        if not self.hidden:
            self.parts.append(' '.join(data.split()) + ' ')


def attachment_parts(message: EmailMessage) -> list[EmailMessage]:
    """Find files, including inline images, without descending into attached mail.

    MIME tree semantics: https://docs.python.org/3.12/library/email.message.html
    """
    parts = []
    pending = [message]
    while pending:
        part = pending.pop()
        inline_file = (part.get_content_disposition() == 'inline' or part.get('Content-ID')) and part.get_content_maintype() != 'text'
        if (part.get_content_disposition() == 'attachment' or part.get_filename()
                or part.get_content_type() == 'message/rfc822' or (inline_file and not part.is_multipart())):
            parts.append(part)
        elif part.is_multipart():
            pending.extend(reversed(part.get_payload()))
    return parts


def attachment_name(part: EmailMessage) -> str:
    """Keep untrusted filenames inside Downloads, visible, and below NAME_MAX."""
    fallback = 'attachment' + (mimetypes.guess_extension(part.get_content_type()) or '.bin')
    name = str(part.get_filename() or fallback).replace('\\', '/').rsplit('/', 1)[-1]
    name = ''.join(char if char.isprintable() else '_' for char in name).strip().lstrip('.-') or fallback
    suffix = Path(name).suffix
    if len(suffix.encode('utf-8')) > 32:
        suffix = ''
    stem = name[:-len(suffix)] if suffix else name
    return stem.encode('utf-8')[:180].decode('utf-8', 'ignore') + suffix


def attachment_bytes(part: EmailMessage) -> bytes:
    """Decode transfer encoding; serialize attached messages with their headers."""
    try:
        if part.get_content_type() == 'message/rfc822' and part.is_multipart():
            return part.get_payload(0).as_bytes(policy=policy.SMTP)
        if part.is_multipart():
            return part.as_bytes(policy=policy.SMTP)
        data = part.get_payload(decode=True)
        if not isinstance(data, bytes) or part.defects:
            raise ValueError('Missing payload')
        return data
    except Exception:
        raise RuntimeError('This attachment could not be decoded; private diagnostics suppressed.') from None


def download_directory() -> Path:
    """Use the desktop Downloads folder without evaluating shell configuration."""
    try:
        result = subprocess.run(['xdg-user-dir', 'DOWNLOAD'], stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, timeout=3, check=True)
        path = Path(result.stdout.decode('utf-8').strip())
        if path.is_absolute():
            return path
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return Path.home() / 'Downloads'


def save_attachment(part: EmailMessage, directory: Path) -> Path:
    """Write a private file; exclusive creation prevents overwrites and symlinks.

    https://docs.python.org/3.12/library/os.html#os.open
    """
    data = attachment_bytes(part)
    directory = directory.expanduser().absolute()
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    name = attachment_name(part)
    suffix = Path(name).suffix
    stem = name[:-len(suffix)] if suffix else name
    for number in range(1000):
        path = directory / (name if number == 0 else f'{stem} ({number}){suffix}')
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            continue
        try:
            with os.fdopen(descriptor, 'wb') as file:
                file.write(data)
        except BaseException:
            path.unlink()
            raise
        return path
    raise RuntimeError('Too many matching filenames in the download folder.')


def open_attachment(path: Path) -> str:
    """Ask the desktop to open an explicitly selected file, never a shell command."""
    # GIO launches the associated app without waiting for the viewer to close.
    # See `gio help open`; file paths are absolute arguments, never shell text.
    if path.suffix.casefold() in {'.desktop', '.exe', '.com', '.msi', '.bat', '.cmd', '.sh', '.appimage'}:
        return 'Saved, but executable/launcher attachments are not opened by this client.'
    try:
        result = subprocess.run(['gio', 'open', str(path.absolute())], stdin=subprocess.DEVNULL,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        if result.returncode == 0:
            return 'Opened with the desktop application.'
    except (OSError, subprocess.SubprocessError):
        pass
    return 'Could not launch a viewer. Open the saved file from your file manager.'


def show_attachments(screen: curses.window, raw: str) -> str:
    """Select incoming attachments, then explicitly save or open each one."""
    try:
        parts = attachment_parts(BytesParser(policy=policy.default).parsebytes(raw.encode('utf-8')))
        if not parts:
            return 'This message has no attachments.'
        saved: dict[int, Path] = {}
        status = ''
        while True:
            index = choose(screen, 'ATTACHMENTS',
                           [f'{attachment_name(part)}  [{clean(part.get_content_type())}]' for part in parts])
            if index is None:
                return status
            part = parts[index]
            details = (f'{attachment_name(part)}\nType: {clean(part.get_content_type())}\n'
                       f'Size: {len(attachment_bytes(part)):,} bytes\n\n'
                       'Open only files you trust. External viewers may access the network.\n'
                       'Opening also saves a copy in your Downloads folder.')
            while True:
                choice = text_view(screen, details, 'ATTACHMENT | o open | s save | q back', {'o', 's', 'q'}, status)
                if choice == 'q':
                    break
                if index not in saved:
                    saved[index] = save_attachment(part, download_directory())
                path = saved[index]
                status = f'Saved: {path}'
                if choice == 'o':
                    status = open_attachment(path) + f' Saved: {path}'
    except Exception:
        return 'Attachment operation failed; private diagnostics suppressed. Check your Downloads folder.'


def message_text(raw: str, row: dict) -> str:
    """Decode MIME, prefer plain text, and remove terminal control characters."""
    message = BytesParser(policy=policy.default).parsebytes(raw.encode('utf-8'))
    lines = [f"Account: {clean(row['account'])}   Folder: {clean(row.get('mailbox', 'inbox'))}   ID: {clean(row['id'])}"]
    for header in ('Date', 'From', 'To', 'Cc', 'Subject'):
        if message.get(header):
            lines.append(f'{header}: {clean(message[header])}')
    lines.append('')
    body = message.get_body(preferencelist=('plain', 'html'))
    if body is None:
        lines.append('[No readable text body; this message may contain attachments or encrypted content.]')
    else:
        content = body.get_content()
        if body.get_content_type() == 'text/html':
            parser = HtmlText()
            parser.feed(content)
            content = '\n'.join(line.strip() for line in ''.join(parser.parts).splitlines() if line.strip())
        lines.append(content)
    attachments = [attachment_name(part) for part in attachment_parts(message)]
    if attachments:
        lines.extend(['', 'Attachments:', *attachments])
    text = '\n'.join(lines).replace('\r\n', '\n').replace('\r', '\n')
    return ''.join(char for char in text if char.isprintable() or char in '\n\t') + '\n'


def message_cache_key(row: dict) -> tuple:
    """Scope bodies by account, folder, UID epoch, UID and immutable Message-ID."""
    return (row['account'], row.get('mailbox', 'inbox'), str(row['id']),
            row.get('uidvalidity'), normalized_id(row.get('message-id')))


def read_raw(row: dict) -> str:
    """Read once per identity, sharing an in-flight read with the prefetcher."""
    key = message_cache_key(row)
    with MESSAGE_CACHE_LOCK:
        if key in MESSAGE_CACHE:
            MESSAGE_CACHE.move_to_end(key)
            return MESSAGE_CACHE[key]
        future = MESSAGE_READS.get(key)
        owner = future is None
        if owner:
            future = MESSAGE_READS[key] = Future()
    if not owner:
        return future.result()
    try:
        if row.get('_cached') and not normalized_id(row.get('message-id')):
            raise RuntimeError('Refresh this cached message before opening it.')
        with BODY_READ_SLOTS:
            result = run_himalaya([
                '--account', row['account'], 'message', 'read',
                '--mailbox', row.get('mailbox', 'inbox'), '--raw', '--', str(row['id']),
            ])
        if not isinstance(result.get('message'), str):
            raise ValueError('Unexpected message format')
        raw = result['message']
        if (row.get('uidvalidity') or row.get('_cached')) and normalized_id(row.get('message-id')):
            headers = BytesParser(policy=policy.default).parsebytes(raw.encode('utf-8'), headersonly=True)
            if normalized_id(headers.get('Message-ID')) != normalized_id(row.get('message-id')):
                raise ValueError('Message identity changed; refresh needed')
        # RAM only: include normal PDF attachments, but cap both item and total
        # encoded size. UIDVALIDITY/Message-ID prevent reuse after a UID reset.
        with MESSAGE_CACHE_LOCK:
            if len(raw.encode('utf-8')) <= 32 * 1024 * 1024:
                MESSAGE_CACHE[key] = raw
                while len(MESSAGE_CACHE) > 16 or sum(len(value.encode('utf-8')) for value in MESSAGE_CACHE.values()) > MESSAGE_CACHE_LIMIT:
                    MESSAGE_CACHE.popitem(last=False)
        future.set_result(raw)
        return raw
    except Exception:
        error = RuntimeError('Could not open this message; refresh to retry. Private diagnostics suppressed.')
        future.set_exception(error)
        raise error from None
    finally:
        with MESSAGE_CACHE_LOCK:
            MESSAGE_READS.pop(key, None)


def prefetch_message(row: dict) -> None:
    """Warm only the highlighted message, with one bounded background read."""
    global PREFETCH_JOB, PREFETCH_KEY
    key = message_cache_key(row)
    if not PREFETCH_ENABLED or key == PREFETCH_KEY or (PREFETCH_JOB is not None and not PREFETCH_JOB.done()):
        return
    with MESSAGE_CACHE_LOCK:
        if key in MESSAGE_CACHE:
            return
    PREFETCH_KEY = key
    job = PREFETCH_JOB = Future()

    def read() -> None:
        try:
            read_raw(row)
        except Exception:
            pass  # Explicit opening can retry; never print background diagnostics.
        finally:
            job.set_result(None)

    # A slow/offline read must not stop the terminal from exiting.
    Thread(target=read, name='inbox-prefetch', daemon=True).start()


def read_message(row: dict) -> str:
    """Render safely, keeping MIME exceptions out of diagnostics."""
    try:
        return message_text(read_raw(row), row)
    except Exception:
        raise RuntimeError('Could not render this message; private diagnostics suppressed.') from None


def show_message(screen: curses.window, row: dict) -> None:
    """Read a message and reply without leaving the interactive browser."""
    screen.erase()
    put_line(screen, 0, 'Opening message (read-only)... q back')
    screen.refresh()
    with MESSAGE_CACHE_LOCK:
        ready = message_cache_key(row) in MESSAGE_CACHE
    job = background(read_raw, row) if PREFETCH_ENABLED and not ready else None
    if job is not None:
        while not job.done():
            screen.timeout(100)
            try:
                if screen.get_wch() in ('q', '\x1b'):
                    job.cancel()
                    return
            except curses.error:
                pass
            finally:
                screen.timeout(-1)
    raw = job.result() if job is not None else read_raw(row)
    try:
        text = message_text(raw, row)
    except Exception:
        raise RuntimeError('Could not render this message; private diagnostics suppressed.') from None
    status = ''
    while True:
        key = text_view(screen, text, 'r reply | R reply all | a attachments | / search | q back', {'r', 'R', 'a', 'q'}, status)
        if key == 'q':
            return
        status = show_attachments(screen, raw) if key == 'a' else compose(screen, row, reply_all=key == 'R')


@contextmanager
def terminal_child(screen: curses.window):
    """Temporarily hand the terminal to an editor and restore it on every exit."""
    curses.mousemask(0)
    curses.def_prog_mode()
    curses.endwin()
    try:
        yield
    finally:
        curses.reset_prog_mode()
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
        screen.keypad(True)
        screen.clearok(True)


def input_line(screen: curses.window, prompt: str) -> str | None:
    """Read one line with Escape to cancel, without terminal escape echo."""
    value = ''
    while True:
        y = screen.getmaxyx()[0] - 1
        screen.move(y, 0)
        screen.clrtoeol()
        put_line(screen, y, prompt + value, curses.A_BOLD)
        screen.refresh()
        key = screen.get_wch()
        if key == '\x1b':
            return None
        if key in ('\n', '\r', curses.KEY_ENTER):
            return value
        if key in ('\b', '\x7f', curses.KEY_BACKSPACE):
            value = value[:-1]
        elif isinstance(key, str) and key.isprintable():
            value += key


def text_view(screen: curses.window, text: str, help_text: str,
              actions: set[str], status: str = '') -> str:
    """Scrollable, searchable text with keyboard/mouse navigation and actions."""
    offset = 0
    query = ''
    while True:
        height, width = screen.getmaxyx()
        page = max(1, height - 2)
        lines = [part for line in text.splitlines()
                 for part in (textwrap.wrap(line.expandtabs(4), max(1, width - 2), replace_whitespace=False) or [''])]
        offset = max(0, min(offset, max(0, len(lines) - page)))
        screen.erase()
        put_line(screen, 0, help_text, curses.A_BOLD)
        for y, line in enumerate(lines[offset:offset + page], 1):
            put_line(screen, y, line)
        put_line(screen, height - 1, status or f'Lines {offset + 1}-{min(len(lines), offset + page)}/{len(lines)} | arrows/wheel scroll')
        screen.refresh()
        key = screen.get_wch()
        if isinstance(key, str) and key in actions:
            return key
        if key in ('j', curses.KEY_DOWN):
            offset += 1
        elif key in ('k', curses.KEY_UP):
            offset -= 1
        elif key in (' ', '\x06', curses.KEY_NPAGE):
            offset += page
        elif key in ('\x02', curses.KEY_PPAGE):
            offset -= page
        elif key in ('g', curses.KEY_HOME):
            offset = 0
        elif key in ('G', curses.KEY_END):
            offset = len(lines)
        elif key == curses.KEY_MOUSE:
            try:
                buttons = curses.getmouse()[4]
                offset += 3 if buttons & getattr(curses, 'BUTTON5_PRESSED', 0) else -3 if buttons & curses.BUTTON4_PRESSED else 0
            except curses.error:
                pass
        elif key in ('/', 'n'):
            if key == '/':
                query = input_line(screen, 'Find: ') or ''
            if query:
                matches = [i for i, line in enumerate(lines) if query.casefold() in line.casefold()]
                if matches:
                    offset = next((i for i in matches if i > offset), matches[0])
                else:
                    status = 'No match.'


def choose(screen: curses.window, title: str, choices: list[str]) -> int | None:
    """Select a list item without entering a shell command."""
    index = 0
    while choices:
        screen.erase()
        put_line(screen, 0, title + ' | Enter select | q cancel', curses.A_BOLD)
        page = max(1, screen.getmaxyx()[0] - 2)
        top = max(0, index - page + 1)
        for y, item in enumerate(choices[top:top + page], 1):
            put_line(screen, y, item, curses.A_REVERSE if top + y - 1 == index else 0)
        put_line(screen, screen.getmaxyx()[0] - 1, 'Enter select | q cancel | arrows/wheel scroll')
        screen.refresh()
        key = screen.get_wch()
        if key in ('q', '\x1b'):
            return None
        if key in ('\n', '\r', curses.KEY_ENTER):
            return index
        if key in ('j', curses.KEY_DOWN):
            index = min(len(choices) - 1, index + 1)
        elif key in ('k', curses.KEY_UP):
            index = max(0, index - 1)
        elif key in (curses.KEY_NPAGE, ' '):
            index = min(len(choices) - 1, index + page)
        elif key == curses.KEY_PPAGE:
            index = max(0, index - page)
        elif key in ('g', curses.KEY_HOME):
            index = 0
        elif key in ('G', curses.KEY_END):
            index = len(choices) - 1
        elif key == curses.KEY_MOUSE:
            try:
                _, _, y, _, buttons = curses.getmouse()
                if buttons & curses.BUTTON4_PRESSED:
                    index = max(0, index - 3)
                elif buttons & getattr(curses, 'BUTTON5_PRESSED', 0):
                    index = min(len(choices) - 1, index + 3)
                elif buttons & (curses.BUTTON1_CLICKED | curses.BUTTON1_DOUBLE_CLICKED):
                    if 1 <= y <= page and top + y - 1 < len(choices):
                        index = top + y - 1
                        if buttons & curses.BUTTON1_DOUBLE_CLICKED:
                            return index
            except curses.error:
                pass
    return None


def choose_file(screen: curses.window) -> Path | None:
    """Browse files or paste a path; hidden files remain available by exact path."""
    directory = Path.home()
    while True:
        try:
            entries = sorted((path for path in directory.iterdir() if not path.name.startswith('.')),
                             key=lambda path: (not path.is_dir(), path.name.casefold()))
        except OSError:
            text_view(screen, 'Cannot list this folder.', 'q back', {'q'})
            directory = directory.parent
            continue
        options = ['[Type/paste a file or folder path]', '../']
        options.extend(clean(path.name) + ('/' if path.is_dir() else '') for path in entries)
        index = choose(screen, f'ATTACH FILE: {directory}', options)
        if index is None:
            return None
        if index == 0:
            value = input_line(screen, 'File/folder path (Escape cancels): ')
            if not value:
                continue
            path = Path(value).expanduser()
            if not path.is_absolute():
                path = directory / path
        else:
            path = directory.parent if index == 1 else entries[index - 2]
        if path.is_dir():
            directory = path
        else:
            return path.absolute()


def draft_attachments(draft: str) -> list[str]:
    """Read only explicit local Attach headers, never paths from the mail body."""
    parsed = Parser(policy=policy.default).parsestr(draft)
    return [str(value).strip() for value in parsed.get_all('Attach', []) if str(value).strip()]


def change_attachments(screen: curses.window, draft: str, remove: bool = False) -> str | None:
    """Modify local-only attachment headers; the caller validates before saving."""
    paths = draft_attachments(draft)
    if remove:
        if not paths:
            return None
        index = choose(screen, 'REMOVE ATTACHMENT', [clean(path) for path in paths])
        if index is None:
            return None
        paths.pop(index)
    else:
        path = choose_file(screen)
        if path is None:
            return None
        value = str(path)
        if value != value.strip() or not value.isprintable():
            raise RuntimeError('Attachment paths must be printable, without trailing whitespace.')
        if value in paths:
            return None
        paths.append(value)
    parsed = Parser(policy=policy.default).parsestr(draft)
    del parsed['Attach']
    for value in paths:
        parsed['Attach'] = value
    # Drafts are UTF-8 text, not transport MIME. Never fold paths across lines.
    return parsed.as_string(policy=policy.default.clone(utf8=True, max_line_length=0))


def save_draft(path: Path, text: str) -> None:
    """Replace only a successfully validated draft, with private permissions."""
    descriptor, name = tempfile.mkstemp(prefix='.attachment-edit-', dir=path.parent)
    temporary = Path(name)
    try:
        with os.fdopen(descriptor, 'w', encoding='utf-8') as file:
            file.write(text)
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def draft_directory() -> Path:
    """Keep mail drafts out of the working directory and any source repository."""
    path = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'himalaya-inbox/drafts'
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)
    return path


@contextmanager
def outbox_db() -> Iterator[sqlite3.Connection]:
    """Open the private durable queue; SQLite transactions serialize send/cancel."""
    directory = draft_directory().parent
    directory.chmod(0o700)
    path = directory / 'outbox.sqlite3'
    # Create with private permissions from the outset, not after writing mail.
    descriptor = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    os.close(descriptor)
    path.chmod(0o600)
    connection = sqlite3.connect(path, timeout=5)
    connection.row_factory = sqlite3.Row
    connection.execute('PRAGMA secure_delete=ON')
    connection.execute('''CREATE TABLE IF NOT EXISTS outbox (
        id TEXT PRIMARY KEY, account TEXT NOT NULL, config TEXT NOT NULL,
        due REAL NOT NULL, created REAL NOT NULL, status TEXT NOT NULL,
        payload BLOB, note TEXT NOT NULL DEFAULT ''
    )''')
    try:
        with connection:
            yield connection
    finally:
        connection.close()


def queue_message(account: str, message: EmailMessage, minutes: int = 5) -> str:
    """Queue the confirmed immutable message without contacting a mail server."""
    if not 1 <= minutes <= 1440:
        raise RuntimeError('Choose a delay between 1 and 1440 minutes.')
    identifier = uuid.uuid4().hex
    now = time.time()
    config = CONFIG_ARGS[-1] if CONFIG_ARGS else str(Path.home() / '.config/himalaya/config.toml')
    with outbox_db() as connection:
        connection.execute('INSERT INTO outbox(id,account,config,due,created,status,payload) VALUES(?,?,?,?,?,?,?)',
                           (identifier, account, config, now + minutes * 60, now, 'pending', message.as_bytes()))
    return identifier


def pending_messages() -> list[dict]:
    """Return pending and delivery-result records, never backend diagnostics."""
    with outbox_db() as connection:
        return [dict(row) for row in connection.execute('SELECT * FROM outbox ORDER BY created DESC')]


def cancel_queued(identifier: str) -> bool:
    """Cancel only while pending; a worker that already claimed it wins the race."""
    with outbox_db() as connection:
        cursor = connection.execute("UPDATE outbox SET status='cancelled', payload=NULL, note='Cancelled before sending; local queued copy removed.' WHERE id=? AND status='pending'", (identifier,))
        return cursor.rowcount == 1


def claim_due(now: float | None = None) -> dict | None:
    """Commit the claim BEFORE any SMTP attempt, preventing duplicate workers.

    A crash after claiming leaves the record in 'sending'; it is NEVER picked up
    again automatically. The user must inspect Sent before attempting a new send.
    https://www.sqlite.org/lang_transaction.html
    """
    with outbox_db() as connection:
        connection.execute('BEGIN IMMEDIATE')
        row = connection.execute("SELECT * FROM outbox WHERE status='pending' AND due<=? ORDER BY due LIMIT 1",
                                 (time.time() if now is None else now,)).fetchone()
        if row is None:
            return None
        connection.execute("UPDATE outbox SET status='sending', note='Delivery started; cancellation is no longer possible.' WHERE id=?", (row['id'],))
        return dict(row)


def process_outbox() -> None:
    """Process due messages once each, with no automatic retry after failure."""
    while item := claim_due():
        status = 'failed'
        note = 'Configuration changed or is unavailable; nothing was sent.'
        try:
            read_settings(item['config'])
            # Keep MIME as bytes: decoding 8-bit UTF-8 body text before parsing
            # loses the byte-preserving representation needed by as_bytes().
            # https://docs.python.org/3.12/library/email.parser.html
            message = BytesParser(policy=policy.SMTP).parsebytes(item['payload'])
            configured = SETTINGS[item['account']]['email'].casefold()
            actual = {a.casefold() for _, a in getaddresses(message.get_all('From', []))}
            if actual != {configured}:
                raise ValueError('Sender identity changed')
            note = send_confirmed(item['account'], message)
            status = 'sent' if note.startswith('SENT.') else 'sent-copy-failed' if note.startswith('SENT,') else 'uncertain'
        except Exception:
            # Once delivery may have begun, never guess that retrying is safe.
            status = 'uncertain'
            note = 'Worker interrupted or configuration unavailable. Check Sent before retrying; no automatic retry.'
        with outbox_db() as connection:
            connection.execute('UPDATE outbox SET status=?, note=?, payload=CASE WHEN ?=\'sent\' THEN NULL ELSE payload END WHERE id=?',
                               (status, note, status, item['id']))


def scheduler_active() -> bool:
    """Do not silently queue mail when no background sender is running."""
    try:
        result = subprocess.run(['systemctl', '--user', 'is-active', '--quiet', 'himalaya-inbox-outbox.timer'],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=5)
        return result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def outbox_view(screen: curses.window) -> None:
    """Inspect scheduled mail and cancel pending deliveries atomically."""
    screen.keypad(True)
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    selected = 0
    status = ''
    screen.timeout(1000)
    try:
        while True:
            items = pending_messages()
            selected = max(0, min(selected, len(items) - 1))
            page = max(1, screen.getmaxyx()[0] - 3)
            top = max(0, selected - page + 1)
            screen.erase()
            put_line(screen, 0, 'OUTBOX | Enter details | x cancel scheduled mail | q back', curses.A_BOLD)
            for y, item in enumerate(items[top:top + page], 1):
                remaining = max(0, int(item['due'] - time.time()))
                state = f'queued {remaining // 60}:{remaining % 60:02d}' if item['status'] == 'pending' else item['status']
                subject = '(local queued body removed)'
                if item['payload']:
                    headers = BytesParser(policy=policy.default).parsebytes(item['payload'], headersonly=True)
                    subject = clean(headers.get('Subject', '(no subject)'))
                put_line(screen, y, f"{state:<18} {item['account']:<12} {subject}", curses.A_REVERSE if top + y - 1 == selected else 0)
            if not items:
                put_line(screen, 1, 'No queued messages.')
            put_line(screen, screen.getmaxyx()[0] - 1, status or 'Cancellation works until delivery starts. Closing the browser does not cancel mail.')
            screen.refresh()
            try:
                key = screen.get_wch()
            except curses.error:
                continue
            if key in ('q', '\x1b'):
                return
            if key in ('j', curses.KEY_DOWN):
                selected += 1
            elif key in ('k', curses.KEY_UP):
                selected -= 1
            elif key == 'x' and items:
                status = ('CANCELLED. This email will not be sent.' if cancel_queued(items[selected]['id'])
                          else 'Cannot cancel: delivery has already started, or this item is no longer queued.')
            elif key in ('\n', '\r', curses.KEY_ENTER) and items:
                item = items[selected]
                text = item['note'] + '\n\n'
                if item['payload']:
                    text += message_text(item['payload'].decode('utf-8'), {'account': item['account'], 'id': item['id']})
                screen.timeout(-1)
                text_view(screen, text, 'q back to Outbox', {'q'})
                screen.timeout(1000)
    finally:
        screen.timeout(-1)


def reply_template(raw: str, account: str, reply_all: bool = False) -> str:
    """Preserve RFC 5322 ancestry and honor Reply-To, excluding own addresses."""
    source = Parser(policy=policy.default).parsestr(raw)
    own = {a['email'].casefold() for a in SETTINGS.values()}
    sender_is_self = any(address.casefold() in own for _, address in getaddresses(source.get_all('From', [])))
    recipients = source.get_all('To', []) if sender_is_self else source.get_all('Reply-To', []) or source.get_all('From', [])
    if reply_all:
        recipients += source.get_all('To', [])
    used = set(own)

    def addresses(values: list[str]) -> str:
        output = []
        for name, address in getaddresses([str(value) for value in values]):
            if address and address.casefold() not in used:
                used.add(address.casefold())
                output.append(formataddr((clean(name), address)))
        return ', '.join(output)

    to = addresses(recipients)
    cc = addresses(source.get_all('Cc', [])) if reply_all else ''
    subject = clean(source.get('Subject', ''))
    if not re.match(r'^re\s*:', subject, re.I):
        subject = 'Re: ' + subject
    parent = message_ids(source.get('Message-ID'))
    refs = message_ids(source.get('References')) or message_ids(source.get('In-Reply-To'))
    refs = list(dict.fromkeys([*refs, *parent]))
    quoted = message_text(raw, {'account': account, 'id': ''}).split('\n\n', 1)[-1]
    headers = [f'X-Himalaya-Account: {account}', f'To: {to}', f'Cc: {cc}', f'Subject: {subject}', 'Attach: ']
    if parent:
        headers.append('In-Reply-To: ' + ' '.join(f'<{v}>' for v in parent))
    if refs:
        headers.append('References: ' + ' '.join(f'<{v}>' for v in refs))
    return '\n'.join(headers) + '\n\n\n\n' + '\n'.join('> ' + line for line in quoted.splitlines()) + '\n'


def build_message(draft: str) -> tuple[str, EmailMessage]:
    """Validate editable fields and construct the exact message to confirm/send."""
    parsed = Parser(policy=policy.default).parsestr(draft)
    allowed = {'x-himalaya-account', 'to', 'cc', 'subject', 'in-reply-to', 'references', 'attach'}
    if any(key.lower() not in allowed for key in parsed.keys()) or parsed.defects:
        raise RuntimeError('Draft has unsupported headers; keep Account, To, Cc, Subject, Attach and reply identifiers only.')
    if any(len(parsed.get_all(key, [])) > 1 for key in allowed - {'attach'}):
        raise RuntimeError('Draft has duplicate headers.')
    account = str(parsed.get('X-Himalaya-Account', '')).strip()
    if account not in SETTINGS:
        raise RuntimeError('Draft account is not configured.')
    message = EmailMessage(policy=policy.SMTP)
    identity = SETTINGS[account]
    message['From'] = formataddr((identity.get('display-name', ''), identity['email']))
    for key in ('To', 'Cc'):
        value = parsed.get(key)
        if value:
            if value.defects or any(not a.username or not a.domain for a in value.addresses):
                raise RuntimeError(f'Invalid {key} address; edit the draft.')
            message[key] = str(value)
    if not message.get('To') and not message.get('Cc'):
        raise RuntimeError('Add at least one recipient.')
    message['Subject'] = str(parsed.get('Subject', ''))
    for key in ('In-Reply-To', 'References'):
        ids = message_ids(parsed.get(key))
        if ids:
            message[key] = ' '.join(f'<{value}>' for value in ids)
    message['Date'] = format_datetime(datetime.now().astimezone())
    message['Message-ID'] = make_msgid(domain=identity['email'].rsplit('@', 1)[-1])
    body = parsed.get_payload()
    if not isinstance(body, str) or (not body.strip() and not draft_attachments(draft)):
        raise RuntimeError('The message is empty; add body text or an attachment.')
    message.set_content(body, charset='utf-8')
    total = 0
    for value in draft_attachments(draft):
        if not value.isprintable():
            raise RuntimeError('Attachment paths must be printable and on a single line.')
        try:
            path = Path(value).expanduser()
            if not path.is_absolute():
                raise RuntimeError('Use an absolute path or ~/path in each Attach header.')
            # O_NONBLOCK avoids hanging on FIFOs; fstat rejects devices/directories.
            descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            if not stat.S_ISREG(os.fstat(descriptor).st_mode):
                os.close(descriptor)
                raise RuntimeError('Only regular files can be attached.')
            with os.fdopen(descriptor, 'rb') as file:
                data = file.read(MAX_ATTACHMENT_BYTES - total + 1)
        except (OSError, ValueError):
            raise RuntimeError(f'Cannot read attachment {clean(value)}; fix or remove its Attach header.') from None
        total += len(data)
        if total > MAX_ATTACHMENT_BYTES:
            raise RuntimeError('Attachments exceed the 20 MiB combined file-size limit.')
        content_type, encoding = mimetypes.guess_type(path.name)
        if not content_type or encoding or content_type.startswith(('message/', 'multipart/')):
            content_type = 'application/octet-stream'
        maintype, subtype = content_type.split('/', 1)
        # Base64 preserves arbitrary bytes. Only basenames leave the laptop;
        # local Attach headers are deliberately absent from the outgoing MIME.
        # https://docs.python.org/3.12/library/email.message.html#email.message.EmailMessage.add_attachment
        message.add_attachment(data, maintype=maintype, subtype=subtype, filename=path.name, cte='base64')
    return account, message


def send_confirmed(account: str, message: EmailMessage) -> str:
    """Send once, then save Sent separately; never retry an uncertain delivery."""
    payload = message.as_bytes()
    try:
        run_private(['--account', account, 'message', 'send'], payload)
    except RuntimeError:
        return 'Delivery is uncertain. Check Sent before retrying; your draft is kept.'
    # Gmail SMTP already saves Sent mail. Other providers need an explicit copy.
    host = SETTINGS[account].get('smtp', {}).get('server', '')
    if not re.search(r'(^|://)smtp\.(gmail|googlemail)\.com(?::|$)', host):
        try:
            run_private(['--account', account, 'message', 'add', '--mailbox', 'sent', '--flag', 'seen'], payload)
        except RuntimeError:
            return 'SENT, but saving the Sent copy failed. Do NOT resend; your draft is kept.'
    return 'SENT. Press u in the message list to refresh the conversation.'


# Trusted editor code only. Contacts are decoded as JSON, never evaluated as Lua.
# Built-in completion and its automatic trigger follow Neovim's documentation:
# https://github.com/neovim/neovim/blob/v0.11.5/runtime/doc/insert.txt
EDITOR_LUA = r'''
local contacts = vim.json.decode(table.concat(vim.fn.readfile(vim.env.HIMALAYA_INBOX_CONTACTS), '\n'))
for _, contact in ipairs(contacts) do
  contact.search = vim.fn.tolower(contact.name .. ' ' .. contact.email)
end
vim.opt.completeopt = {'menuone', 'noselect', 'noinsert'}
vim.opt.shortmess:append('c')
vim.opt.pumheight = 12

-- Return a byte offset and the unfinished recipient, including multiword names.
-- Never complete body text, quoted headers, or the middle of an existing address.
local function recipient_prefix()
  local cursor = vim.api.nvim_win_get_cursor(0)
  local row, col = cursor[1], cursor[2]
  local lines = vim.api.nvim_buf_get_lines(0, 0, row, false)
  for _, line in ipairs(lines) do
    if line:match('^%s*$') then return end
  end
  local header = row
  while header > 1 and lines[header]:match('^%s') do header = header - 1 end
  local field, first = lines[header]:match('^([%a%-]+):%s*()')
  if not field or (field:lower() ~= 'to' and field:lower() ~= 'cc') then return end
  local line = lines[row]
  if line:sub(col + 1):match('^%s*[^,%s]') then return end
  if header ~= row then first = line:match('^%s*()') end
  local before = line:sub(first, col)
  local start = before:match('.*,%s*()') or before:match('^%s*()')
  local base = before:sub(start)
  if base:find('[<>";:%c]') then return end
  return first + start - 2, base
end

function HimalayaInboxComplete(findstart, base)
  if findstart == 1 then
    local start = recipient_prefix()
    return start or -3
  end
  local words = {}
  -- Neovim may move the cursor back to the start while asking for matches.
  if vim.fn.strchars(base) >= 2 and not base:find('[,<>";:%c]') then
    local query = vim.fn.tolower(base)
    for _, contact in ipairs(contacts) do
      if contact.search:find(query, 1, true) and query ~= vim.fn.tolower(contact.email) then
        -- Name matching need not match the inserted address's first characters.
        words[#words + 1] = {word = contact.email, menu = contact.name, equal = 1}
      end
    end
  end
  return {words = words, refresh = 'always'}
end
vim.opt.completefunc = 'v:lua.HimalayaInboxComplete'

local scheduled = false
vim.api.nvim_create_autocmd('InsertCharPre', {
  callback = function()
    if scheduled or vim.fn.state('m') == 'm' then return end
    scheduled = true
    vim.schedule(function()
      scheduled = false
      if vim.fn.mode() ~= 'i' or vim.fn.pumvisible() == 1 then return end
      local start, base = recipient_prefix()
      if start and vim.fn.strchars(base) >= 2 and #HimalayaInboxComplete(0, base).words > 0 then
        vim.api.nvim_feedkeys(vim.keycode('<C-x><C-u>'), 'n', false)
      end
    end)
  end,
})

vim.keymap.set('i', '<Tab>', function()
  return vim.fn.pumvisible() == 1 and '<C-n>' or '<Tab>'
end, {expr = true})
vim.keymap.set('i', '<S-Tab>', function()
  return vim.fn.pumvisible() == 1 and '<C-p>' or '<S-Tab>'
end, {expr = true})
vim.keymap.set('i', '<CR>', function()
  if vim.fn.pumvisible() == 1 then
    return vim.fn.complete_info({'selected'}).selected >= 0 and '<C-y>' or '<C-e><CR>'
  end
  return '<CR>'
end, {expr = true})
'''


@contextmanager
def editor_environment() -> Iterator[dict[str, str]]:
    """Pass contacts privately to Neovim; remove temporary copies after editing."""
    with tempfile.TemporaryDirectory(prefix='himalaya-inbox-editor-') as directory:
        paths = {}
        for name, content in (('init.lua', EDITOR_LUA), ('contacts.json', json.dumps(CONTACTS))):
            path = Path(directory) / name
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(descriptor, 'w', encoding='utf-8') as file:
                file.write(content)
            paths[name] = str(path)
        yield dict(os.environ, NVIM_LOG_FILE='/dev/null',
                   HIMALAYA_INBOX_INIT=paths['init.lua'], HIMALAYA_INBOX_CONTACTS=paths['contacts.json'])


def compose(screen: curses.window, row: dict | None = None, reply_all: bool = False,
            draft_path: Path | None = None) -> str:
    """Edit in Neovim; saving or quitting the editor never sends a message."""
    if not SETTINGS:
        return 'Replying requires account settings; reopen the browser normally.'
    if draft_path is None:
        if row is not None:
            template = reply_template(read_raw(row), row['account'], reply_all)
        else:
            accounts = list(SETTINGS)
            index = choose(screen, 'Send from account', accounts)
            if index is None:
                return 'Compose cancelled.'
            template = f'X-Himalaya-Account: {accounts[index]}\nTo: \nCc: \nSubject: \nAttach: \n\n'
        descriptor, name = tempfile.mkstemp(prefix='draft-', suffix='.txt', dir=draft_directory())
        draft_path = Path(name)
        with os.fdopen(descriptor, 'w', encoding='utf-8') as file:
            file.write(template)
    editor = shutil.which('nvim')
    if not editor:
        return 'Neovim is unavailable; draft kept. Press d to resume later.'
    while True:
        # No plugins/modelines/swap/undo/shada: untrusted quoted mail must not
        # execute editor code, and draft contents must not leak into other caches.
        with editor_environment() as environment, terminal_child(screen):
            result = subprocess.run([editor, '-u', 'NONE', '-n', '-i', 'NONE', '--cmd',
                                     'set nomodeline noswapfile nobackup nowritebackup noundofile',
                                     '--cmd', 'lua dofile(vim.env.HIMALAYA_INBOX_INIT)',
                                     '+set filetype=mail', '--', str(draft_path)],
                                    env=environment)
        if result.returncode:
            return 'Editor cancelled; draft kept. Press d to resume.'
        try:
            account, message = build_message(draft_path.read_text(encoding='utf-8'))
        except (RuntimeError, ValueError, OSError) as error:
            reason = str(error) if isinstance(error, RuntimeError) else 'Draft could not be parsed.'
            choice = text_view(screen, reason, 'e edit | q keep draft', {'e', 'q'})
            if choice == 'e':
                continue
            return 'Draft kept. Press d to resume.'
        delay = 5
        attachment_status = ''
        while True:
            preview = message_text(message.as_string(), {'account': account, 'id': 'new draft'})
            count = len(attachment_parts(message))
            choice = text_view(screen, preview, f'REVIEW | a attach({count}) x remove | s queue{delay}m t delay N now | e edit q draft',
                               {'a', 'x', 's', 't', 'N', 'e', 'q'}, attachment_status)
            if choice in ('a', 'x'):
                try:
                    draft = change_attachments(screen, draft_path.read_text(encoding='utf-8'), remove=choice == 'x')
                    if draft is None:
                        attachment_status = 'Attachments unchanged.'
                    else:
                        new_account, new_message = build_message(draft)
                        save_draft(draft_path, draft)
                        account, message = new_account, new_message
                        attachment_status = 'Attachment removed.' if choice == 'x' else 'File attached; check the attachment list below.'
                except (RuntimeError, OSError, ValueError) as error:
                    attachment_status = str(error) if isinstance(error, RuntimeError) else 'Could not update attachments; draft unchanged.'
                continue
            if choice != 't':
                break
            value = input_line(screen, 'Delay in minutes (1-1440, blank = 5): ')
            if value is not None:
                try:
                    new_delay = int(value or '5')
                    if 1 <= new_delay <= 1440:
                        delay = new_delay
                except ValueError:
                    pass
        if choice == 'e':
            continue
        if choice not in ('s', 'N'):
            return 'Not sent. Draft kept; press d to resume.'
        if choice == 's' and not scheduler_active():
            text_view(screen, 'The background sender is not active. Enable himalaya-inbox-outbox.timer first. Nothing was queued or sent; your draft is kept.',
                      'q back', {'q'})
            return 'Scheduler is not active. Draft kept.'
        confirmation = 'SEND' if choice == 's' else 'SEND NOW'
        prompt = f'Type {confirmation} to ' + (f'queue for {delay} minutes: ' if choice == 's' else 'send immediately: ')
        if input_line(screen, prompt) != confirmation:
            return 'Not sent. Draft kept; press d to resume.'
        screen.erase()
        put_line(screen, 0, 'Queueing locally...' if choice == 's' else 'Sending once; please wait...')
        screen.refresh()
        if choice == 's':
            queue_message(account, message, delay)
            status = f'QUEUED for {delay} minutes. Press o in the message list for Outbox, then x to cancel before delivery starts.'
        else:
            status = send_confirmed(account, message)
        if status.startswith(('SENT.', 'QUEUED')):
            draft_path.unlink()
        text_view(screen, status, 'q return to browser', {'q'})
        return status


def put_line(screen: curses.window, y: int, text: str, attr: int = 0) -> None:
    """Clip text and tolerate a terminal resize during drawing."""
    height, width = screen.getmaxyx()
    if 0 <= y < height and width > 1:
        try:
            safe = ''.join(char if char.isprintable() else ' ' for char in text)
            screen.addnstr(y, 0, safe, width - 1, attr)
        except curses.error:
            pass


def entry_line(group: list[dict]) -> str:
    """Show the latest message as the conversation summary."""
    row = group[0]
    date = message_date(row)
    stamp = 'unknown' if date.year == 1 else date.astimezone().strftime('%Y-%m-%d %H:%M')
    accounts = {item['account'] for item in group}
    account = clean(row['account']) if len(accounts) == 1 else 'multiple'
    sender = ', '.join(clean(a.get('name') or a.get('email', '')) for a in row.get('from', []))
    if row.get('sent'):
        sender = 'You (sent)'
    unread = '*' if any(is_unread(item) for item in group) else ' '
    count = f'[{len(group)}]' if len(group) > 1 else ''
    return f'{unread} {count:>4} {stamp:16} {account:12.12} {sender:18.18} {clean(row.get("subject") or "(no subject)")}'


def browse(screen: curses.window, rows: list[dict], title: str = 'Unified inbox',
           threaded: bool = True, in_thread: bool = False, catalog: list[dict] | None = None) -> None:
    """Browse headers with keys or mouse; Enter opens a thread or its message."""
    global REFRESH_JOB
    screen.keypad(True)
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    curses.mousemask(curses.ALL_MOUSE_EVENTS)
    if catalog is None:
        catalog = rows
    selected = top = 0
    query = status = ''
    editing = False
    view = 'inbox'
    filtered = []
    while True:
        anchor = set()
        if REFRESH_JOB is not None and REFRESH_JOB.done():
            if 0 <= selected < len(filtered):
                anchor = {row_anchor(row) for row in filtered[selected]}
            try:
                fresh = REFRESH_JOB.result()
                old_thread = {row_anchor(row) for row in rows} if in_thread else set()
                catalog[:] = fresh
                if in_thread:
                    fresh = next((group for group in conversations(fresh)
                                  if any(row_anchor(row) in old_thread for row in group)), [])
                    fresh.sort(key=message_date)
                rows[:] = fresh
                status = 'Refreshed.'
            except Exception:
                status = 'Refresh failed; showing previous headers. Press u to retry.'
            REFRESH_JOB = None
        entries = conversations(rows) if threaded else [[row] for row in rows]
        if not in_thread and view != 'all':
            entries = [group for group in entries if any(
                row.get('in_inbox', True) if view == 'inbox' else row.get('sent', False)
                for row in group)]
        filtered = [group for group in entries if not query or any(
            query.casefold() in ' '.join((clean(row.get('subject', '')), clean(row.get('from', [])),
                                         clean(row['account']), clean(row['id']))).casefold()
            for row in group)]
        if anchor:
            selected = next((i for i, group in enumerate(filtered)
                             if any(row_anchor(row) in anchor for row in group)), selected)
        height, _ = screen.getmaxyx()
        page = max(1, height - 5)
        selected = max(0, min(selected, len(filtered) - 1))
        top = max(0, min(top, selected, max(0, len(filtered) - page)))
        if selected >= top + page:
            top = selected - page + 1
        screen.erase()
        mode = 'conversations' if threaded else 'messages'
        heading = 'Conversation: oldest -> newest' if in_thread else f'Unified {view}'
        put_line(screen, 0, f'{heading} | {len(filtered)} {mode} | * unread', curses.A_BOLD)
        put_line(screen, 1, 'Arrows/wheel scroll | Enter open | r reply | R reply all | / filter | q back')
        put_line(screen, 2, 'c compose | d drafts | o outbox | u refresh | i inbox | s sent | a all | t threads' if not in_thread
                 else 'Select a message to reply to it. Press u to refresh this conversation.')
        for y, group in enumerate(filtered[top:top + page], 3):
            put_line(screen, y, entry_line(group), curses.A_REVERSE if y - 3 + top == selected else 0)
        if not filtered:
            put_line(screen, 3, 'No matching messages.' if query else 'No messages in this view.')
        footer = f'Filter: {query}' if editing or query else status or f'{selected + 1 if filtered else 0}/{len(filtered)}'
        if REFRESH_JOB is not None:
            footer = 'Previous headers; refreshing in background | ' + footer
        put_line(screen, height - 1, footer, curses.A_BOLD)
        screen.refresh()
        if PREFETCH_ENABLED and filtered:
            prefetch_message(min(filtered[selected], key=message_date))
        polling = REFRESH_JOB is not None or (PREFETCH_ENABLED and PREFETCH_JOB is not None and not PREFETCH_JOB.done())
        try:
            if polling:
                screen.timeout(100)
            key = screen.get_wch()
        except curses.error:
            continue
        finally:
            if polling:
                screen.timeout(-1)
        if editing:
            if key in ('\n', '\r', curses.KEY_ENTER):
                editing = False
            elif key == '\x1b':
                query, editing = '', False
            elif key in ('\b', '\x7f', curses.KEY_BACKSPACE):
                query = query[:-1]
            elif isinstance(key, str) and key.isprintable():
                query += key
            selected = top = 0
            continue
        status = ''
        if key in ('q', 'Q'):
            return
        if key == '/':
            editing = True
        elif key == '\x1b':
            query = ''
        elif key == 't' and not in_thread:
            threaded = not threaded
            selected = top = 0
        elif key in ('i', 's', 'a') and not in_thread:
            view = {'i': 'inbox', 's': 'sent', 'a': 'all'}[key]
            selected = top = 0
            query = ''
        elif key == 'o':
            outbox_view(screen)
        elif key == 'u':
            if REFRESH_JOB is None:
                REFRESH_JOB = background(load_all)
        elif key in ('r', 'R', 'c', 'd'):
            try:
                if key == 'c':
                    status = compose(screen)
                elif key == 'd':
                    paths = sorted(draft_directory().glob('draft-*.txt'), key=lambda p: p.stat().st_mtime, reverse=True)
                    choice = choose(screen, 'Local drafts (newest first)', [p.name for p in paths])
                    status = compose(screen, draft_path=paths[choice]) if choice is not None else 'No draft selected.'
                elif filtered:
                    group = filtered[selected]
                    # A conversation summary replies to its latest received mail,
                    # not accidentally to our own most recent sent copy.
                    target = next((row for row in group if not row.get('sent')), group[0])
                    status = compose(screen, target, reply_all=key == 'R')
            except (RuntimeError, OSError):
                status = 'Could not prepare the draft; private diagnostics suppressed.'
        elif key in (curses.KEY_DOWN, 'j'):
            selected += 1
        elif key in (curses.KEY_UP, 'k'):
            selected -= 1
        elif key in (curses.KEY_NPAGE, ' ', '\x06'):
            selected += page
        elif key in (curses.KEY_PPAGE, '\x02'):
            selected -= page
        elif key in (curses.KEY_HOME, 'g'):
            selected = 0
        elif key in (curses.KEY_END, 'G'):
            selected = len(filtered) - 1
        elif key == curses.KEY_MOUSE:
            try:
                _, _, y, _, buttons = curses.getmouse()
            except curses.error:
                continue
            if buttons & curses.BUTTON4_PRESSED:
                selected -= 3
            elif buttons & getattr(curses, 'BUTTON5_PRESSED', 0):
                selected += 3
            elif (buttons & (curses.BUTTON1_CLICKED | curses.BUTTON1_DOUBLE_CLICKED)
                  and 3 <= y < 3 + page and top + y - 3 < len(filtered)):
                selected = top + y - 3
                if buttons & curses.BUTTON1_DOUBLE_CLICKED:
                    key = '\n'
        if key in ('\n', '\r', curses.KEY_ENTER) and filtered:
            group = filtered[selected]
            try:
                if len(group) > 1:
                    browse(screen, sorted(group, key=message_date), 'Conversation', False, True, catalog)
                else:
                    show_message(screen, group[0])
            except RuntimeError as error:
                status = str(error)


def render(rows: list[dict]) -> None:
    """Print full sender/subject text; pipe to `less -S` for horizontal scrolling."""
    print(f'{"ACCOUNT:ID":<26} {"DATE (local)":16}   {"FROM":<34} SUBJECT')
    for row in rows:
        date = message_date(row)
        date_text = 'unknown' if date.year == 1 else date.astimezone().strftime('%Y-%m-%d %H:%M')
        unread = '*' if is_unread(row) else ' '
        senders = ', '.join(
            f"{address['name']} <{address.get('email', '')}>" if address.get('name')
            else address.get('email', '')
            for address in row.get('from', [])
        )
        reference = clean(f"{row['account']}:{row['id']}")
        print(f'{reference:<26} {date_text:16} {unread} {clean(senders):<34} {clean(row.get("subject", ""))}')


def positive_int(value: str) -> int:
    number = int(value)
    if number <= 0:
        raise argparse.ArgumentTypeError('must be positive')
    return number


def row_anchor(row: dict) -> tuple:
    """Preserve the selected message/thread when background refresh adds mail."""
    return (row['account'], normalized_id(row.get('message-id')) or message_cache_key(row))


def read_settings(path: str | None, cache: bool = False) -> None:
    """Read a single Himalaya TOML config locally; never print it or credentials."""
    global SETTINGS, CONFIG_ARGS, HEADER_CACHE_PATH, HEADER_CACHE_READY
    path = path or os.environ.get('HIMALAYA_CONFIG') or str(Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'himalaya/config.toml')
    config_path = Path(os.path.expandvars(path)).expanduser()
    try:
        config_bytes = config_path.read_bytes()
        SETTINGS = tomllib.loads(config_bytes.decode('utf-8'))['accounts']
    except (OSError, ValueError, KeyError):
        raise RuntimeError('Cannot read Himalaya configuration; use --config with a single TOML file.') from None
    CONFIG_ARGS = ['--config', str(config_path)]
    REFERENCE_CACHE.clear()
    with MESSAGE_CACHE_LOCK:
        MESSAGE_CACHE.clear()
    FOLDER_CACHE.clear()
    HEADER_CACHE_PATH = None
    HEADER_CACHE_READY = False
    if cache:
        # Scope even identically named accounts to the exact configuration;
        # persist only its hash, not credential commands or server settings.
        identity = hashlib.sha256(str(config_path.resolve()).encode() + b'\0' + config_bytes).hexdigest()
        directory = Path(os.environ.get('XDG_CACHE_HOME', Path.home() / '.cache')) / 'himalaya-inbox'
        HEADER_CACHE_PATH = directory / f'headers-{identity}.json'
        read_header_cache()
        for item in FOLDER_CACHE.values():
            for row in item['rows']:
                if normalized_id(row.get('message-id')):
                    REFERENCE_CACHE[row['account'], normalized_id(row['message-id'])] = tuple(row['references'])


def main() -> None:
    global PREFETCH_ENABLED, REFRESH_JOB, CONTACTS
    parser = argparse.ArgumentParser(description='Interactive Himalaya inbox, complete conversations, replies and cancellable scheduled sending.')
    group = parser.add_mutually_exclusive_group()
    group.add_argument('-n', '--limit', type=positive_int, help='plain-list mode: show only the newest N messages in total')
    group.add_argument('--all', action='store_true', help='fetch every inbox page; may take longer')
    parser.add_argument('--list', action='store_true', help='print a list instead of opening the browser')
    parser.add_argument('--flat', action='store_true', help='start with individual messages instead of conversations')
    parser.add_argument('--config', help='path to a single Himalaya TOML configuration file')
    parser.add_argument('--outbox', action='store_true', help='open the scheduled-message Outbox directly')
    parser.add_argument('--process-outbox', action='store_true', help='background worker: send due, explicitly queued messages once')
    parser.epilog = 'Interactive: full conversations across Inbox, Sent and filed mail (excluding Drafts/Trash/Junk). Piped/--list: newest 50 inbox messages unless --all/-n is given.'
    args = parser.parse_args()
    if args.process_outbox:
        process_outbox()
        return
    if args.outbox:
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            parser.error('--outbox requires an interactive terminal')
        curses.wrapper(outbox_view)
        return
    interactive = not args.list and sys.stdin.isatty() and sys.stdout.isatty()
    if interactive:
        if args.limit is not None:
            parser.error('-n/--limit applies to --list or piped output; interactive threads load all included folders.')
        read_settings(args.config, cache=True)
        IO_STOP.clear()
        try:
            if HEADER_CACHE_READY:
                rows = deduplicate([dict(row, _cached=True) for item in FOLDER_CACHE.values() for row in item['rows']])
                CONTACTS = collect_contacts(rows)
                REFRESH_JOB = background(load_all)
            else:
                print('Building the local header index for the first time...', file=sys.stderr, flush=True)
                rows = load_all()
            PREFETCH_ENABLED = True
            curses.wrapper(browse, rows, 'Unified inbox', not args.flat)
        finally:
            PREFETCH_ENABLED = False
            stop_background()
        return
    if args.config:
        read_settings(args.config)
    limit = args.limit if args.limit is not None else (None if args.all or interactive else 50)
    accounts = [item['name'] for item in run_himalaya(['account', 'list'])['accounts']]
    if not accounts:
        raise RuntimeError('No Himalaya accounts configured.')
    print(f'Loading inbox headers from {len(accounts)} accounts...', file=sys.stderr, flush=True)
    with ThreadPoolExecutor(max_workers=min(len(accounts), 5)) as pool:
        batches = list(pool.map(lambda account: fetch(account, limit), accounts))
    rows = merge(batches, limit)
    render(rows)
    qualifier = 'All fetched' if args.all else 'Newest'
    print(f'{qualifier}: {len(rows)} inbox messages across {len(accounts)} accounts. * = unread.', file=sys.stderr)


if __name__ == '__main__':
    try:
        main()
    except BrokenPipeError:
        sys.exit(0)
    except RuntimeError as error:
        print(f'Unified inbox unavailable: {clean(error)}', file=sys.stderr)
        sys.exit(1)
    except (KeyError, TypeError, curses.error):
        print('Unified inbox unavailable: unexpected data or unsupported terminal; try --list.', file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
